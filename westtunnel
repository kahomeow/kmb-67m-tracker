<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>港島往屯門 巴士到站時間表</title>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f4f6f9;
      color: #333;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    .card {
      background: white;
      width: 100%;
      max-width: 480px;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      border: 1px solid #e0e6ed;
      overflow: hidden;
      margin-bottom: 20px;
    }
    .header {
      background: #0055aa; /* 港島線主題藍 */
      color: white;
      padding: 20px;
      text-align: center;
    }
    .header h1 { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
    .header p { font-size: 12px; opacity: 0.85; }
    
    .select-container {
      margin-top: 14px;
      display: flex;
      justify-content: center;
    }
    .stop-select {
      background: white;
      color: #0055aa;
      border: 1px solid #cbd5e0;
      padding: 8px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      outline: none;
      cursor: pointer;
      width: 90%;
      max-width: 340px;
      text-align: center;
    }

    .update-btn {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: white;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 12px;
      margin-top: 10px;
      cursor: pointer;
    }
    .eta-list { padding: 16px; }
    .stop-group-title {
      font-size: 14px;
      font-weight: bold;
      color: #0055aa;
      margin: 16px 0 10px 4px;
      display: flex;
      align-items: center;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 6px;
    }
    .stop-group-title::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 14px;
      background: #0055aa;
      margin-right: 8px;
      border-radius: 2px;
    }
    .route-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff5f5;
      border: 1.5px solid #ff5252;
      border-radius: 12px;
      padding: 12px 16px;
      margin-bottom: 10px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .route-item.ctb {
      background: #fffdf0;
      border-color: #ffd100;
    }
    .route-badge { display: flex; flex-direction: column; align-items: flex-start; min-width: 65px; }
    .route-number { font-size: 20px; font-weight: 800; color: #1a365d; }
    .company-tag { font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: bold; margin-top: 2px; }
    .ctb-tag { background-color: #ffd100; color: #333; }
    .kmb-tag { background-color: #e60012; color: white; }
    
    .route-info { flex: 1; padding: 0 12px; }
    .dest-name { font-size: 14px; font-weight: bold; color: #2d3748; }
    .eta-times { text-align: right; min-width: 125px; }
    .primary-eta { font-size: 15px; font-weight: bold; color: #c62828; }
    .secondary-eta { font-size: 11px; color: #718096; margin-top: 3px; }
    .status-msg { text-align: center; padding: 24px; color: #718096; font-size: 14px; }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">
      <h1>🇭🇰 港島往屯門 巴士到站時間</h1>
      <p>📍 選擇中環 / 金鐘 / 銅鑼灣車站觀測過海路線</p>

      <div class="select-container">
        <select id="stopSelector" class="stop-select" onchange="loadAllEta()">
          <option value="ALL">📍 所有車站 (一次看全部)</option>
          <option value="CENTRAL_POTTINGER">中環 - 砵典乍街 (CW776)</option>
          <option value="CENTRAL_LI_YUEN">中環 - 利源東街</option>
          <option value="ADMIRALTY_ADM">金鐘 - 港鐵 B 出口 / 海富中心</option>
          <option value="CWB_YEE_WO">銅鑼灣 - 怡和街</option>
          <option value="CWB_CANAL_TIN_LOK">銅鑼灣 - 堅拿道東 / 天樂里</option>
        </select>
      </div>

      <button class="update-btn" onclick="loadAllEta()">🔄 更新到站時間</button>
    </div>

    <div class="eta-list" id="etaContainer">
      <div class="status-msg">正在載入班次...</div>
    </div>
  </div>

  <script>
    // 站點清單 (精確配對你提供的 KMB Hash ID 與 Citybus 6 位數 ID)
    const TARGET_STOPS = [
      {
        key: 'CENTRAL_POTTINGER',
        name: '中環 - 砵典乍街',
        kmbId: '4AA350AD8FFF4786',
        ctbId: '001034'
      },
      {
        key: 'CENTRAL_LI_YUEN',
        name: '中環 - 利源東街',
        kmbId: '83B717529F9794BC',
        ctbId: '001055'
      },
      {
        key: 'ADMIRALTY_ADM',
        name: '金鐘 - 海富中心 / 港鐵 B 出口',
        kmbId: '55371F963B58DC5B',
        ctbId: '001139'
      },
      {
        key: 'CWB_YEE_WO',
        name: '銅鑼灣 - 怡和街',
        kmbId: 'BBFDDE87E6A6DD13',
        ctbId: '002554'
      },
      {
        key: 'CWB_CANAL_TIN_LOK',
        name: '銅鑼灣 - 堅拿道東 / 天樂里',
        kmbId: 'D073FFE1CF019F1F', // 天樂里 (WC665)
        ctbId: '002440'            // 堅拿道東
      }
    ];

    // 主要過海往新界西/屯門路線清單
    const ALL_ROUTES = [
      '960', '960A', '960B', '960C', '960P', '960S', '960X', 'P960',
      '961', '961P', '962', '962A', '962G', '962P', '962X', 'X962',
      '950', '952', '952P', '955', 'N952', 'N960', 'N962', '968', '969'
    ];

    // 城巴（CTB）專屬 ETA 查詢
    async function fetchCtbEta(stopId, route) {
      if (!stopId) return [];
      try {
        const res = await fetch(`https://rt.data.gov.hk/v2/transport/citybus/eta/CTB/${stopId}/${route}`);
        if (!res.ok) return [];
        const data = await res.json();
        return (data.data || []).filter(i => i.eta).map(i => ({
          ...i,
          co: 'CTB',
          dest_tc: i.dest_tc
        }));
      } catch (err) {
        return [];
      }
    }

    // 九巴（KMB）專屬 ETA 查詢
    async function fetchKmbStopEta(kmbStopId) {
      if (!kmbStopId) return [];
      try {
        const res = await fetch(`https://data.etabus.gov.hk/v1/transport/kmb/stop-eta/${kmbStopId}`);
        if (!res.ok) return [];
        const data = await res.json();
        return (data.data || []).filter(i => i.eta).map(i => ({
          ...i,
          co: 'KMB',
          dest_tc: i.dest_tc || '目的地'
        }));
      } catch (err) {
        return [];
      }
    }

    async function fetchStopAllRoutes(stopObj) {
      const ctbPromises = ALL_ROUTES.map(r => fetchCtbEta(stopObj.ctbId, r));
      const kmbPromise = fetchKmbStopEta(stopObj.kmbId);

      const [ctbResults, kmbResults] = await Promise.all([
        Promise.all(ctbPromises),
        kmbPromise
      ]);

      let combined = [];
      ctbResults.forEach(list => { combined = combined.concat(list); });
      combined = combined.concat(kmbResults);

      return combined;
    }

    async function loadAllEta() {
      const container = document.getElementById('etaContainer');
      const selectedKey = document.getElementById('stopSelector').value;
      const now = new Date();

      try {
        const filteredStops = selectedKey === 'ALL' 
          ? TARGET_STOPS 
          : TARGET_STOPS.filter(s => s.key === selectedKey);

        const promises = filteredStops.map(stopObj => fetchStopAllRoutes(stopObj));
        const results = await Promise.all(promises);

        let html = '';

        filteredStops.forEach((stop, index) => {
          let rawList = results[index] || [];

          html += `<div class="stop-group-title">${stop.name}</div>`;

          if (rawList.length > 0) {
            const routeMap = {};
            rawList.forEach(item => {
              if (!routeMap[item.route]) routeMap[item.route] = [];
              routeMap[item.route].push(item);
            });

            const routes = Object.keys(routeMap).sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

            routes.forEach(routeName => {
              let matched = routeMap[routeName];

              // 去重與時間排序
              const uniqueList = [];
              const seenTimes = new Set();
              matched.forEach(item => {
                const key = `${item.route}_${item.eta}_${item.dest_tc}`;
                if (!seenTimes.has(key)) {
                  seenTimes.add(key);
                  uniqueList.push(item);
                }
              });

              uniqueList.sort((a, b) => new Date(a.eta) - new Date(b.eta));

              const bus1 = uniqueList[0];
              const bus2 = uniqueList[1];

              const diff1 = Math.max(0, Math.round((new Date(bus1.eta) - now) / 60000));
              const timeStr1 = new Date(bus1.eta).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

              let primaryStr = diff1 === 0 ? '即將到站' : `${diff1} 分鐘 <span style="font-size:11px;font-weight:normal;">(${timeStr1})</span>`;
              let secondEtaStr = '暫無次班';
              if (bus2 && bus2.eta) {
                const diff2 = Math.max(0, Math.round((new Date(bus2.eta) - now) / 60000));
                const timeStr2 = new Date(bus2.eta).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                secondEtaStr = `次班: ${timeStr2} (${diff2}分)`;
              }

              let companyClass = bus1.co === 'CTB' ? 'ctb' : 'kmb';
              let tagText = bus1.co === 'CTB' ? '城巴' : '九巴';
              let tagClass = bus1.co === 'CTB' ? 'ctb-tag' : 'kmb-tag';

              html += `
                <div class="route-item ${companyClass}">
                  <div class="route-badge">
                    <span class="route-number">${routeName}</span>
                    <span class="company-tag ${tagClass}">${tagText}</span>
                  </div>
                  <div class="route-info">
                    <div class="dest-name">往 ${bus1.dest_tc || '目的地'}</div>
                  </div>
                  <div class="eta-times">
                    <div class="primary-eta">${primaryStr}</div>
                    <div class="secondary-eta">${secondEtaStr}</div>
                  </div>
                </div>
              `;
            });
          } else {
            html += `<div class="status-msg" style="padding: 12px; font-size: 13px;">暫無即時過海班次資料</div>`;
          }
        });

        container.innerHTML = html;
      } catch (err) {
        console.error(err);
        container.innerHTML = `<div class="status-msg">載入失敗，請稍後重試</div>`;
      }
    }

    loadAllEta();
    setInterval(loadAllEta, 15000);
  </script>
</body>
</html>
